# URL publique, sans slash final. Sert au SEO, au sitemap et aux liens canoniques.
NEXT_PUBLIC_SITE_URL=https://bricman-mathis.fr

# Resend — https://resend.com
# L'adresse d'expédition doit être vérifiée dans Resend.
RESEND_API_KEY=
CONTACT_TO_EMAIL=contact@oryzons.com
CONTACT_FROM_EMAIL=portfolio@bricman-mathis.fr

# Optionnel. Si vide, aucun script d'analytics n'est injecté.
# Plausible ne dépose pas de cookie : pas de bannière nécessaire.
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=
NEXT_PUBLIC_PLAUSIBLE_SRC=https://plausible.io/js/script.js
